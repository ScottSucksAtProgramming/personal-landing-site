---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import ManPage from '../../layouts/ManPage.astro';
import Section from '../../components/Section.astro';
import { SITE } from '../../site.config';
import { getPosts, isoDate, readMinutes } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, cover, coverAlt } = post.data;
---
<ManPage
  title={`${title} | ${SITE.fullName}`}
  description={description ?? title}
  man="SCOTT-NOTES(7)"
  section="Field Notes"
  command={`man 7 ${post.id}`}
  pagerName={`${post.id}(7)`}
  current="writing"
>
  <Section title="Name">
    <h1 class="name"><b>{post.id}</b> - {title}</h1>
  </Section>

  <Section title="Date">
    <p>
      <time datetime={isoDate(date)}>{isoDate(date)}</time>
      {updated && <> (updated <time datetime={isoDate(updated)}>{isoDate(updated)}</time>)</>}
      &middot; {readMinutes(post)} min read
    </p>
    {cover && <Image class="cover" src={cover} alt={coverAlt ?? ''} widths={[600, 1000, 1400]} sizes="(max-width: 700px) 100vw, 66ch" />}
  </Section>

  <Section title="Body">
    <div class="prose"><Content /></div>
  </Section>

  <Section title="See also">
    <p><a href="/writing/">scott-notes(7)</a>, <a href="/">scott(1)</a>, <a href={SITE.newsletter.url}>{SITE.newsletter.name.toLowerCase()}(7)</a></p>
  </Section>
</ManPage>
